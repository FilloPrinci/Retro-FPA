; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Retro FPA"
run/main_scene="res://ui/main/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

GameManager="*res://autoload/game_manager.gd"
SettingsManager="*res://autoload/settings_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
InventoryManager="*res://autoload/inventory_manager.gd"
DialogueManager="*res://autoload/dialogue_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/retro_visual_style/plugin.cfg", "res://addons/dialogue_tools/plugin.cfg")

