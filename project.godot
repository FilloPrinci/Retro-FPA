[internationalization]

locale/translations=PackedStringArray("res://translations/dialogue.en.translation", "res://translations/dialogue.it.translation", "res://translations/items.en.translation", "res://translations/items.it.translation", "res://translations/ui.en.translation", "res://translations/ui.it.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=0
textures/default_filters/texture_mipmap_bias=1.0

[retro_style]

force_resolution=true
visual_style=1
